---
import Layout from '../layouts/Layout.astro';
import '../styles/global.css';

// Configuración de WhatsApp - Andrea Tienda Online
const whatsappNumber = "5493743415132"; 
const whatsappLinkDefault = `https://wa.me/${whatsappNumber}?text=Hola Andrea! Vi tu tienda y quiero consultar por un producto.`;

const variants = [
    {
        name: "Kit de Limpieza Pro 3 en 1",
        description: "Limpieza express inalámbrica para azulejos y cocina. ¡80% OFF en la 2da unidad!",
        price: "$29.003",
        image: "/images/hero.png", 
        tag: "ENVÍO GRATIS",
        whatsapp_msg: "Hola Andrea! Quiero el Kit de Limpieza Pro con el 80% OFF en la 2da unidad."
    },
    {
        name: "Pack x3 Citrato de Magnesio",
        description: "Mineral esencial para tu bienestar diario. Incluye de regalo un Porta Esponjas.",
        price: "$19.900",
        image: "/images/variant_original.png", 
        tag: "MÁS ELEGIDO",
        whatsapp_msg: "Hola Andrea! Quiero el Pack x3 de Citrato de Magnesio por $19.900."
    },
    {
        name: "Cepillo a Vapor Pro",
        description: "Eliminá el pelo suelto de tu mascota sin tirones. Incluye guía de regalo.",
        price: "$21.500",
        image: "/images/variant_green.png", 
        tag: "NOVEDAD",
        whatsapp_msg: "Hola Andrea! Me interesa el Cepillo a Vapor Pro para mi mascota."
    }
];

const testimonials = [
    {
        name: "Mariana L.",
        comment: "El cepillo eléctrico me cambió la vida, limpio todo en la mitad de tiempo. ¡Excelente atención!",
        city: "Posadas, Misiones"
    },
    {
        name: "Jorge D.",
        comment: "El Magnesio llegó súper rápido a Eldorado. Muy conforme con la calidad.",
        city: "Eldorado, Misiones"
    }
];
---

<Layout title="Andrea Tienda Online - Bienestar y Hogar">
	<main class="overflow-x-hidden">
		<!-- Navegación -->
		<nav class="sticky top-0 z-50 bg-white/80 backdrop-blur-md border-b border-red-100 py-4">
			<div class="container mx-auto px-6 flex justify-between items-center">
				<div class="flex items-center gap-2">
					<div class="w-10 h-10 bg-red-600 rounded-full flex items-center justify-center text-white font-bold italic">A</div>
					<span class="text-xl font-extrabold text-red-600 tracking-tight">ANDREA<span class="text-green-600">TIENDA</span></span>
				</div>
				<a href={whatsappLinkDefault} class="bg-red-600 hover:bg-red-700 text-white px-5 py-2 rounded-full font-semibold transition-all">Consultar Stock</a>
			</div>
		</nav>

		<!-- Hero Section -->
		<section class="relative pt-20 pb-16">
			<div class="container mx-auto px-6 text-center space-y-8">
				<h1 class="text-5xl md:text-7xl font-black leading-tight text-slate-900">
					Calidad y <span class="text-red-600">Bienestar</span> <br/> en <span class="text-green-600">Misiones</span>
				</h1>
				<p class="text-lg text-slate-600 max-w-2xl mx-auto">
					Productos seleccionados para tu hogar. Envío directo desde Puerto Rico a toda la provincia.
				</p>
				<div class="flex justify-center gap-4">
					<a href="#productos" class="bg-green-600 hover:bg-green-700 text-white text-lg font-bold px-8 py-4 rounded-2xl transition-all shadow-lg">Ver Catálogo</a>
				</div>
			</div>
		</section>

		<!-- Productos -->
		<section id="productos" class="py-12 bg-white">
			<div class="container mx-auto px-6 grid md:grid-cols-3 gap-8">
				{variants.map((variant) => (
					<div class="border border-slate-100 rounded-3xl p-6 hover:shadow-xl transition-all">
						<div class="relative mb-6 overflow-hidden rounded-2xl aspect-square">
							<img src={variant.image} alt={variant.name} class="w-full h-full object-cover" />
							<span class="absolute top-4 left-4 bg-red-600 text-white text-xs font-bold px-3 py-1 rounded-full uppercase">{variant.tag}</span>
						</div>
						<div class="space-y-3">
							<h3 class="text-2xl font-bold text-slate-900">{variant.name}</h3>
							<p class="text-slate-600 text-sm">{variant.description}</p>
							<div class="flex items-center justify-between pt-4 border-t border-slate-50">
								<span class="text-2xl font-black text-red-600">{variant.price}</span>
								<a href={`https://wa.me/${whatsappNumber}?text=${encodeURIComponent(variant.whatsapp_msg)}`} class="p-3 bg-green-100 text-green-600 rounded-xl hover:bg-green-600 hover:text-white transition-colors">
									<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
								</a>
							</div>
						</div>
					</div>
				))}
			</div>
		</section>

		<!-- Footer -->
		<footer class="py-20 bg-slate-900 text-center text-white">
			<h2 class="text-3xl font-black mb-4">¿Dudas con tu pedido?</h2>
			<p class="text-slate-400 mb-8">Chateá conmigo directamente para coordinar el envío.</p>
			<a href={whatsappLinkDefault} class="bg-red-600 px-12 py-5 rounded-2xl font-bold text-xl hover:bg-red-700 transition-all">Hablar con Andrea</a>
			<p class="mt-12 text-slate-500 text-sm">© 2026 Andrea Tienda Online. Puerto Rico, Misiones.</p>
		</footer>
	</main>
</Layout>