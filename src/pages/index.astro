---
import Layout from '../layouts/Layout.astro';
import '../styles/global.css';

// Configuración de WhatsApp
const whatsappNumber = "5493743415132"; // Tu número de contacto profesional
const whatsappMessageDefault = "¡Hola Andrea! Vi tu tienda online y me interesa uno de tus productos.";
const whatsappLinkDefault = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(whatsappMessageDefault)}`;

const variants = [
    {
        name: "Kit de Limpieza Pro 3 en 1",
        description: "Limpieza express inalámbrica para azulejos, cocina y sillones. ¡80% OFF en la 2da unidad!",
        price: "$29.003",
        image: "/images/hero.png", // Usamos hero.png para el producto principal
        tag: "ENVÍO GRATIS",
        whatsapp_msg: "¡Hola Andrea! Quiero el Kit de Limpieza Pro 3 en 1 con el 80% OFF en la 2da unidad."
    },
    {
        name: "Pack x3 Citrato de Magnesio",
        description: "Mineral esencial para el bienestar diario. Incluye de regalo un Porta Esponjas exclusivo.",
        price: "$19.900",
        image: "/images/variant_original.png", // Usamos este nombre que ya tenés
        tag: "MÁS ELEGIDO",
        whatsapp_msg: "¡Hola Andrea! Quiero aprovechar la oferta del Pack x3 de Citrato de Magnesio."
    },
    {
        name: "Cepillo a Vapor Pro",
        description: "Eliminá hasta el 90% del pelo suelto de tu mascota sin tirones. Incluye guía de regalo.",
        price: "$21.500",
        image: "/images/variant_green.png", // Usamos este nombre que ya tenés
        tag: "NOVEDAD",
        whatsapp_msg: "¡Hola Andrea! Me interesa el Cepillo a Vapor Pro para mi mascota."
    }
];

const testimonials = [
    {
        name: "Mariana L.",
        comment: "El cepillo eléctrico me cambió la vida, limpio el baño en la mitad de tiempo y sin esfuerzo. ¡Excelente atención!",
        city: "Posadas, Misiones"
    },
    {
        name: "Jorge D.",
        comment: "El Pack x3 de magnesio llegó súper rápido a mi domicilio. Muy conforme con la calidad del producto.",
        city: "Eldorado, Misiones"
    }
];
---

<Layout title="Andrea Tienda Online - Bienestar y Hogar">
	<main class="overflow-x-hidden">
		<!-- Navegación -->
		<nav class="sticky top-0 z-50 bg-white/80 backdrop-blur-md border-b border-red-100 py-4">
			<div class="container mx-auto px-6 flex justify-between items-center">
				<div class="flex items-center gap-2">
					<div class="w-10 h-10 bg-red-600 rounded-full flex items-center justify-center text-white font-bold italic">A</div>
					<span class="text-xl font-extrabold text-red-600 tracking-tight">ANDREA<span class="text-green-600">TIENDA</span></span>
				</div>
				<a href={whatsappLinkDefault} class="hidden md:block bg-red-600 hover:bg-red-700 text-white px-5 py-2 rounded-full font-semibold transition-all">Consultar Stock</a>
			</div>
		</nav>

		<!-- Hero Section -->
		<section class="relative pt-20 pb-16 md:pt-32 md:pb-24">
			<div class="container mx-auto px-6 grid md:grid-cols-2 gap-12 items-center">
				<div class="space-y-8">
					<div class="inline-block bg-red-100 text-red-600 px-4 py-1.5 rounded-full text-sm font-bold tracking-wide uppercase">
						🚀 Soluciones para tu Hogar
					</div>
					<h1 class="text-5xl md:text-7xl font-black leading-tight text-slate-900">
						Calidad y <span class="text-red-600">Bienestar</span> <br/> en un solo <span class="text-green-600">lugar</span>
					</h1>
					<p class="text-lg md:text-xl text-slate-600 leading-relaxed max-w-lg">
						Descubrí productos seleccionados para hacer tu vida más cómoda. Calidad garantizada y envío directo a tu hogar desde Puerto Rico, Misiones.
					</p>
					<div class="flex flex-col sm:flex-row gap-4">
						<a href={whatsappLinkDefault} class="flex items-center justify-center gap-3 bg-green-600 hover:bg-green-700 text-white text-lg font-bold px-8 py-4 rounded-2xl shadow-xl shadow-green-200 hover:-translate-y-1 transition-all">
							<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
							Pedir por WhatsApp
						</a>
						<a href="#productos" class="flex items-center justify-center gap-2 bg-slate-100 hover:bg-slate-200 text-slate-700 text-lg font-bold px-8 py-4 rounded-2xl transition-all">
							Ver Catálogo
						</a>
					</div>
				</div>
				<div class="relative">
					<div class="absolute inset-0 bg-red-200 blur-3xl rounded-full opacity-30 animate-pulse"></div>
					<img src="/images/magic-brush.png" alt="Productos Andrea Tienda" class="relative z-10 rounded-[2.5rem] shadow-2xl rotate-3 hover:rotate-0 transition-transform duration-500" loading="eager" />
				</div>
			</div>
		</section>

		<!-- Sección de Productos -->
		<section id="productos" class="py-24 bg-white">
			<div class="container mx-auto px-6">
				<div class="text-center mb-16 space-y-4">
					<h2 class="text-4xl md:text-5xl font-black text-slate-900">Nuestras <span class="text-red-600">Ofertas</span> Estrella</h2>
					<p class="text-slate-600 max-w-2xl mx-auto">Seleccionamos lo mejor en tecnología para el hogar y suplementos naturales para vos.</p>
				</div>
				<div class="grid md:grid-cols-3 gap-8">
					{variants.map((variant) => (
						<div class="group bg-white border border-slate-100 rounded-3xl p-6 hover:shadow-2xl hover:border-red-100 transition-all duration-300">
							<div class="relative mb-6 overflow-hidden rounded-2xl aspect-square">
								<img src={variant.image} alt={variant.name} class="w-full h-full object-cover group-hover:scale-110 transition-all duration-500" loading="lazy" />
								<span class="absolute top-4 left-4 bg-red-600 text-white text-xs font-bold px-3 py-1 rounded-full uppercase tracking-tighter shadow-lg">{variant.tag}</span>
							</div>
							<div class="space-y-3">
								<h3 class="text-2xl font-bold text-slate-900">{variant.name}</h3>
								<p class="text-slate-600 text-sm leading-relaxed">{variant.description}</p>
								<div class="flex items-center justify-between pt-4 border-t border-slate-50">
									<span class="text-2xl font-black text-red-600">{variant.price}</span>
									<a href={`https://wa.me/${whatsappNumber}?text=${encodeURIComponent(variant.whatsapp_msg)}`} class="p-3 bg-red-100 text-red-600 rounded-xl group-hover:bg-red-600 group-hover:text-white transition-colors">
										<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
									</a>
								</div>
							</div>
						</div>
					))}
				</div>
			</div>
		</section>

		<!-- Testimonios -->
		<section id="testimoni" class="py-24 bg-[#FEF2F2]">
			<div class="container mx-auto px-6">
				<div class="text-center mb-16 space-y-4">
					<h2 class="text-4xl md:text-5xl font-black text-slate-900">Opiniones de Clientes</h2>
					<p class="text-slate-600">Lo que dicen quienes ya confían en la Garantía Total de nuestra tienda.</p>
				</div>
				<div class="grid md:grid-cols-2 gap-8 max-w-4xl mx-auto">
					{testimonials.map((testi) => (
						<div class="bg-white p-8 rounded-3xl shadow-lg border border-red-50 relative overflow-hidden">
							<div class="absolute top-0 right-0 p-4 opacity-10">
								<svg xmlns="http://www.w3.org/2000/svg" width="60" height="60" fill="currentColor" class="bi bi-chat-quote" viewBox="0 0 16 16">
									<path d="M2.678 11.894a1 1 0 0 1 .287.801 10.97 10.97 0 0 1-.398 2c1.395-.323 2.247-.697 2.634-.893a1 1 0 0 1 .71-.074A8.06 8.06 0 0 0 8 14c3.996 0 7-2.807 7-6 0-3.192-3.004-6-7-6S1 4.808 1 8c0 1.468.617 2.83 1.678 3.894zm-.493 3.905a21.682 21.682 0 0 1-.713.129c-.2.032-.352-.176-.273-.362a9.68 9.68 0 0 0 .244-.637l.003-.01c.248-.72.45-1.548.524-2.319C.743 11.37 0 9.76 0 8c0-3.866 3.582-7 8-7s8 3.134 8 7-3.582 7-8 7a9.06 9.06 0 0 1-2.347-.306c-.52.263-1.639.742-3.468 1.105z"/>
								</svg>
							</div>
							<div class="flex gap-1 text-yellow-500 mb-4">
								{[...Array(5)].map(() => (
									<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16"><path d="M3.612 15.443c-.386.198-.824-.149-.746-.592l.83-4.73L.173 6.765c-.329-.314-.158-.888.283-.95l4.898-.696L7.538.792c.197-.39.73-.39.927 0l2.184 4.327 4.898.696c.441.062.612.636.282.95l-3.522 3.356.83 4.73c.078.443-.36.79-.746.592L8 13.187l-4.389 2.256z"/></svg>
								))}
							</div>
							<p class="text-lg italic text-slate-700 leading-relaxed mb-6 font-medium">"{testi.comment}"</p>
							<div class="flex items-center gap-4">
								<div class="w-12 h-12 bg-red-100 rounded-full flex items-center justify-center text-red-600 font-bold uppercase">{testi.name[0]}</div>
								<div>
									<h4 class="font-bold text-slate-900">{testi.name}</h4>
									<p class="text-xs text-slate-500">{testi.city}</p>
								</div>
							</div>
						</div>
					))}
				</div>
			</div>
		</section>

		<!-- Footer CTA -->
		<section class="py-20 bg-slate-900">
			<div class="container mx-auto px-6 text-center space-y-8">
				<h2 class="text-4xl md:text-5xl font-black text-white leading-tight">¿Lista para hacer tu <span class="text-red-500 italic">vida cómoda</span>?</h2>
				<p class="text-slate-400 max-w-xl mx-auto">Hacé clic abajo para hablar directamente conmigo por WhatsApp y coordinar tu pedido hoy mismo.</p>
				<a href={whatsappLinkDefault} class="inline-flex items-center gap-3 bg-red-600 hover:bg-red-700 text-white text-xl font-bold px-12 py-5 rounded-2xl shadow-2xl shadow-red-900/50 hover:-translate-y-1 transition-all">
					Chatear con Andrea ahora
				</a>
				<p class="text-slate-500 text-sm">© 2026 Andrea Tienda Online. Todos los derechos reservados.</p>
			</div>
		</section>
	</main>
</Layout>
